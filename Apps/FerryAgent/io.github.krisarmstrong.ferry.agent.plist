<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.krisarmstrong.ferry.agent</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/FerryAgent</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>io.github.krisarmstrong.ferry</string>
	</array>
	<key>MachServices</key>
	<dict>
		<key>$(FERRY_TEAM_ID).io.github.krisarmstrong.ferry.agent</key>
		<true/>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ProcessType</key>
	<string>Adaptive</string>
</dict>
</plist>
