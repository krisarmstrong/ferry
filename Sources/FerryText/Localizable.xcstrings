        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferry no pudo terminar esto. Inténtalo de nuevo; si sigue fallando, vuelve a conectar el dispositivo o vuelve a abrir Ferry."
          }
        }
      }
    },
    "Ferry's helper didn't answer in time. Try again in a moment." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferry's helper didn't answer in time. Try again in a moment."
