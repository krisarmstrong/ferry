      }
    },
    "Cancelled." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancelled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancelado."
          }
        }
      }
    },
    "Ferry can't do this from the Mac on this device. Do it on the device instead." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferry can't do this from the Mac on this device. Do it on the device instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferry no puede hacer esto desde la Mac en este dispositivo. Hazlo en el dispositivo."
          }
        }
      }
    },
    "Ferry can't find adb. Get it from the Ferry menu, then try again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferry can't find adb. Get it from the Ferry menu, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferry no encuentra adb. Obtenlo desde el menú de Ferry e inténtalo de nuevo."
          }
        }
      }
    },
    "Ferry can't save to its folder in Documents. Allow Ferry in Privacy & Security." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferry can't save to its folder in Documents. Allow Ferry in Privacy & Security."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferry no puede guardar en su carpeta de Documentos. Permite el acceso a Ferry en Privacidad y seguridad."
          }
        }
      }
    },
    "Ferry couldn't finish this. Try again; if it keeps failing, reconnect the device or reopen Ferry." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferry couldn't finish this. Try again; if it keeps failing, reconnect the device or reopen Ferry."
