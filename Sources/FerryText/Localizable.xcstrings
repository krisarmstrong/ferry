{
  "sourceLanguage" : "en",
  "strings" : {
    "A newer version of the app is installed. Uninstall it first." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A newer version of the app is installed. Uninstall it first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay una versión más reciente de la app instalada. Desinstálala primero."
          }
        }
      }
    },
    "Another app is using the device. Quit Image Capture or Android File Transfer." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another app is using the device. Quit Image Capture or Android File Transfer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otra app está usando el dispositivo. Sal de Captura de Imagen o de Android File Transfer."
          }
        }
      }
    },
    "Another app on the device already defines one of this app's permissions." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another app on the device already defines one of this app's permissions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otra app del dispositivo ya define uno de los permisos de esta app."
          }
        }
      }
    },
    "Another app on the device already uses this app's content provider." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another app on the device already uses this app's content provider."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otra app del dispositivo ya usa el proveedor de contenido de esta app."
