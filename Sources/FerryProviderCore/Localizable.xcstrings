{
  "sourceLanguage" : "en",
  "strings" : {
    "A folder on the device can’t take a package name, such as .app or .rtfd: macOS would open it as an app or a document." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A folder on the device can’t take a package name, such as .app or .rtfd: macOS would open it as an app or a document."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una carpeta del dispositivo no puede tener nombre de paquete, como .app o .rtfd: macOS la abriría como una app o un documento."
          }
        }
      }
    },
    "Ferry can't do this from the Mac on this device. Do it on the device instead." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferry can't do this from the Mac on this device. Do it on the device instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferry no puede hacer esto desde la Mac en este dispositivo. Hazlo en el dispositivo."
          }
        }
      }
    },
    "Ferry couldn't finish this. Try again; if it keeps failing, reconnect the device or reopen Ferry." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferry couldn't finish this. Try again; if it keeps failing, reconnect the device or reopen Ferry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferry no pudo terminar esto. Inténtalo de nuevo; si sigue fallando, vuelve a conectar el dispositivo o vuelve a abrir Ferry."
          }
        }
      }
    },
    "Ferry's helper sent an answer Ferry didn't expect. Quit and reopen Ferry, then try again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferry's helper sent an answer Ferry didn't expect. Quit and reopen Ferry, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El asistente de Ferry envió una respuesta que Ferry no esperaba. Sal de Ferry, vuelve a abrirlo e inténtalo de nuevo."
          }
        }
      }
    },
    "Folders named like an app or a document package, and what they hold, can’t be changed from this Mac. Change them on the device." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folders named like an app or a document package, and what they hold, can’t be changed from this Mac. Change them on the device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las carpetas con nombre de app o de paquete de documento, y lo que contienen, no se pueden cambiar desde esta Mac. Cámbialas en el dispositivo."
          }
        }
      }
    },
    "Packages and app bundles can’t be copied to the device. Compress it into a .zip first." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Packages and app bundles can’t be copied to the device. Compress it into a .zip first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los paquetes de documentos y de apps no se pueden copiar al dispositivo. Primero comprime el paquete en un .zip."
          }
        }
      }
    },
    "Symbolic links and aliases can’t be copied to the device." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Symbolic links and aliases can’t be copied to the device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los enlaces simbólicos y los alias no se pueden copiar al dispositivo."
          }
        }
      }
    },
