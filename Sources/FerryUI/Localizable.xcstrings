    },
    "Finder shows these when a copy, rename or delete on the device does not work." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder muestra estos mensajes cuando no funciona una copia, un cambio de nombre o una eliminación en el dispositivo."
          }
        }
      }
    },
    "Connect the device and choose Transfer files to see its files." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta el dispositivo y elige Transferir archivos para ver sus archivos."
          }
        }
      }
    },
    "Finder shows this in a device's location while the device is not connected or not sharing files." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder muestra esto en la ubicación de un dispositivo mientras el dispositivo no está conectado o no comparte archivos."
          }
        }
      }
    },
    "Packages and app bundles can’t be copied to the device. Compress it into a .zip first." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los paquetes de documentos y de apps no se pueden copiar al dispositivo. Primero comprime el paquete en un .zip."
          }
        }
      }
    },
    "A package is one item on the Mac but a folder on the device, so Ferry does not copy it." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un paquete es un solo ítem en la Mac, pero una carpeta en el dispositivo, así que Ferry no lo copia."
          }
        }
      }
    },
    "Control-click it, choose **Compress**, and copy the .zip instead." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en él con la tecla Control presionada, elige **Comprimir** y copia el .zip en su lugar."
          }
        }
      }
    },
    "Symbolic links and aliases can’t be copied to the device." : {
      "extractionState" : "manual",
      "localizations" : {
