          }
        }
      }
    },
    "Click the address in the menu and choose **Use It** if it is your device, or **Ignore**." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en la dirección en el menú y elige **Usar** si es tu dispositivo, o **Ignorar**."
          }
        }
      }
    },
    "The device is not on Ethernet or Wi-Fi." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dispositivo no está en Ethernet ni en Wi-Fi."
          }
        }
      }
    },
    "Connect the device to Ethernet or Wi-Fi, then click **Use over Wi-Fi** again." : {
      "extractionState" : "manual",
      "localizations" : {
