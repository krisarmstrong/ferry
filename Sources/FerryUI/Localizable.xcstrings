          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloquea el dispositivo y elige **Transferir archivos** en él."
          }
        }
      }
    },
    "File transfer is off or the device is locked." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
