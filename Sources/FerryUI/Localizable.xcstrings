    "Clear" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borrar"
          }
        }
      }
    },
    "Click **Open System Settings**." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en **Abrir Ajustes del Sistema**."
          }
        }
      }
    },
    "Click Install App… and choose an .apk file, or drag one .apk onto the device in the menu. Ferry checks that the file is an Android app, copies it to the device and installs it, replacing an older version of the same app. The menu shows how far the copy has got, then says when the app is installed." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en Instalar app… y elige un archivo .apk, o arrastra un .apk al dispositivo en el menú. Ferry comprueba que el archivo sea una app de Android, lo copia al dispositivo y lo instala, reemplazando una versión anterior de la misma app. El menú muestra cuánto lleva la copia y luego indica cuándo la app está instalada."
          }
        }
      }
    },
    "Click the Ferry icon in the menu bar." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en el icono de Ferry en la barra de menús."
          }
        }
      }
    },
    "Closes the menu. The helper keeps running, so devices stay in Finder." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierra el menú. El asistente sigue en ejecución, así que los dispositivos permanecen en Finder."
          }
        }
      }
    },
    "Connect" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conectar"
          }
        }
      }
    },
    "Connect a USB-C cable to the **USB-C port on the left side** of the unit and to the Mac." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta un cable USB-C al **puerto USB-C del lado izquierdo** de la unidad y a la Mac."
          }
        }
      }
    },
    "Connect by Address…" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conectar por dirección…"
          }
        }
      }
    },
    "Connect the device with a cable and allow USB debugging first." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta primero el dispositivo con un cable y permite la depuración por USB."
          }
        }
      }
    },
    "Control-click a file you opened and choose **Remove Download**. The file stays on the device." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic con la tecla Control presionada en un archivo que abriste y elige **Eliminar descarga**. El archivo permanece en el dispositivo."
          }
        }
      }
    },
    "Copied" : {
