          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza hacia abajo el panel de notificaciones y toca **Cargando este dispositivo mediante USB**."
          }
        }
      }
    },
    "Pull down the notification shade and tap **USB charging this device**." : {
