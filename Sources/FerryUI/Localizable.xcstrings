          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a conectar el dispositivo e inténtalo de nuevo."
          }
        }
      }
    },
    "The device shares no storage, which happens while it is locked." : {
      "extractionState" : "manual",
      "localizations" : {
