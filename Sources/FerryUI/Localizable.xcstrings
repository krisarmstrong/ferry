          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferry no pudo guardar la grabación en Documentos. Sigue en el dispositivo."
          }
        }
      }
    },
    "Click **Choose Folder…** to save it where you pick, or **Discard** to delete it." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
