    "Getting started" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primeros pasos"
          }
        }
      }
    },
    "Go to **Settings** → **System** → **Developer options** and turn on **USB debugging**." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve a **Configuración** → **Sistema** → **Opciones para desarrolladores** y activa **Depuración por USB**."
