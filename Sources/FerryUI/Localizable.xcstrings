    },
    "Ferry can't save to its folder in Documents. Allow Ferry in Privacy & Security." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferry no puede guardar en su carpeta de Documentos. Permite el acceso a Ferry en Privacidad y seguridad."
