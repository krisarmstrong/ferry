    },
    "Cancelled." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancelado."
          }
        }
      }
    },
    "The task stopped before it finished, usually because you cancelled it." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tarea se detuvo antes de terminar, normalmente porque la cancelaste."
          }
        }
      }
    },
    "Start it again if you still need it." : {
      "extractionState" : "manual",
      "localizations" : {
