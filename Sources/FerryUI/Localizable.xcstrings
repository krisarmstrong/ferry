          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay ningún dispositivo conectado que comparta archivos."
          }
        }
      }
    },
    "Connect the device and choose **Transfer files** on it." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta el dispositivo y elige **Transferir archivos** en él."
          }
        }
      }
    },
    "Unlock the device and choose **Transfer files** on it." : {
      "extractionState" : "manual",
      "localizations" : {
