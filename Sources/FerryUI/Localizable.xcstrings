    },
    "The address changed after the menu showed it." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dirección cambió después de que el menú la mostrara."
          }
        }
      }
    },
    "Open the menu again and choose from what it shows now." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre el menú de nuevo y elige entre lo que muestra ahora."
          }
        }
      }
    },
    "Turning on ADB over Wi-Fi restarts ADB on the device, which would stop a transfer, a screen recording or a log." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activar ADB por Wi-Fi reinicia ADB en el dispositivo, lo que detendría una transferencia, una grabación de pantalla o un registro."
          }
        }
      }
    },
    "Let them finish, then try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja que terminen e inténtalo de nuevo."
          }
        }
      }
    },
    "adb refused the request. The rest of the message is adb's reason." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "adb rechazó la solicitud. El resto del mensaje es el motivo de adb."
