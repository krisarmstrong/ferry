          }
        }
      }
    },
    "Use over Wi-Fi starts from a device Ferry serves over USB debugging." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar por Wi-Fi parte de un dispositivo que Ferry sirve mediante la depuración por USB."
          }
        }
      }
    },
    "Connect the device by cable, allow this Mac on it, then try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta el dispositivo con un cable, permite esta Mac en él e inténtalo de nuevo."
          }
